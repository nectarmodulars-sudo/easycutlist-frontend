          "find": [
            "    const o = inst.outputs[idx];",
            "    if (!o._manual) {",
            "      if (!inst.deletedRows) inst.deletedRows = {};",
            "      inst.deletedRows[outKey(o)] = true;",
            "    }",
            "    inst.outputs.splice(idx, 1);",
